/* dinput8.dll's version resource (tools/lc2_dll.py: zig rc /d AXL_VER_NUM=a,b,c,0 /d AXL_VER_STR="a.b.c" from
 * mods/axl/VERSION) */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AXL_VER_NUM
 PRODUCTVERSION AXL_VER_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "hoodcat"
            VALUE "FileDescription", "Axl mod for Mega Man X6 (Mega Man X Legacy Collection 2): dinput8 hook"
            VALUE "FileVersion", AXL_VER_STR
            VALUE "InternalName", "dinput8"
            VALUE "LegalCopyright", "Copyright (c) 2026 hoodcat. MIT License."
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName", "Axl mod for Mega Man X6 (LC2)"
            VALUE "ProductVersion", AXL_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
